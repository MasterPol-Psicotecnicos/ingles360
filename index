<script>
(function(){
  var t=0,n=0;
  document.querySelectorAll("[data-p]").forEach(function(a){
    var v=0; try{ v=+JSON.parse(localStorage.getItem("lpt-progress-"+a.getAttribute("data-p"))||"0")||0; }catch(e){}
    a.querySelector(".pf").style.width=v+"%"; a.querySelector(".pv").textContent=v+"%"; t+=v; n++;
  });
  var p=n?Math.round(t/n):0;
  document.getElementById("allfill").style.width=p+"%";
  document.getElementById("alltxt").textContent="Course progress: "+p+"%";
})();
